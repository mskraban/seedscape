{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": { "maxDuration": 15, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/w/:seed", "destination": "/api/wallpaper?seed=:seed" },
    { "source": "/random", "destination": "/api/wallpaper" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
